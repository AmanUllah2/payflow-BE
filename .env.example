# Copy to .env and adjust. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Postgres (matches docker-compose.yml; local dev only) ---
DATABASE_URL=postgres://payflow:payflow@localhost:5432/payflow
DB_POOL_SIZE=10

# --- Redis (matches docker-compose.yml) ---
REDIS_URL=redis://localhost:6379

# --- Secrets: replace each with a long random string, e.g.
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use different values for each, and never reuse these placeholders outside local dev.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret

# --- Rate limiting ---
RATE_LIMIT_TRANSFERS_PER_MIN=10
