{
  "info": {
    "name": "PayFlow API",
    "description": "Requests for every PayFlow endpoint. Select the \"PayFlow Local\" environment, or edit the `baseUrl` collection variable.\n\nCollection-level tests run on every request: each response must carry an `x-request-id` header, and any 4xx/5xx must use the standard error shape `{ error: { code, message, traceId } }`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('has x-request-id header', () => {",
          "  pm.response.to.have.header('x-request-id');",
          "});",
          "",
          "if (pm.response.code >= 400 && pm.response.headers.get('Content-Type')?.includes('application/json')) {",
          "  const body = pm.response.json();",
          "  // /health/ready returns its own body on 503, not the error envelope",
          "  if (!pm.request.url.getPath().startsWith('/health')) {",
          "    pm.test('error uses standard shape', () => {",
          "      pm.expect(body).to.have.property('error');",
          "      pm.expect(body.error).to.include.keys('code', 'message', 'traceId');",
          "      pm.expect(body.error.traceId).to.eql(pm.response.headers.get('x-request-id'));",
          "    });",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Liveness and readiness probes. Mounted before auth and rate limiting, so no token is needed.",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Returns 200 while the process is up. Does not check Postgres or Redis."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status is ok', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.uptime).to.be.a('number');",
                  "  pm.expect(body.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health/ready", "host": ["{{baseUrl}}"], "path": ["health", "ready"] },
            "description": "Runs every registered dependency check (2s timeout each). 200 `ready` when all pass; 503 `not_ready` when any fails or the server is shutting down."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 or 503', () => pm.expect(pm.response.code).to.be.oneOf([200, 503]));",
                  "pm.test('not cached', () => pm.response.to.have.header('Cache-Control', 'no-store'));",
                  "pm.test('body matches status', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql(pm.response.code === 200 ? 'ready' : 'not_ready');",
                  "  pm.expect(body.checks).to.be.an('object');",
                  "  Object.values(body.checks).forEach((c) => pm.expect(c.status).to.be.oneOf(['up', 'down']));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Errors",
      "description": "Requests that exercise the central error handler.",
      "item": [
        {
          "name": "Unknown route (404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-request-id", "value": "postman-404-check" }],
            "url": { "raw": "{{baseUrl}}/does-not-exist", "host": ["{{baseUrl}}"], "path": ["does-not-exist"] },
            "description": "Returns `NOT_FOUND`. A safe client-supplied `x-request-id` is echoed back as the `traceId`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('NOT_FOUND with echoed traceId', () => {",
                  "  const { error } = pm.response.json();",
                  "  pm.expect(error.code).to.eql('NOT_FOUND');",
                  "  pm.expect(error.traceId).to.eql('postman-404-check');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Malformed JSON body (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"amount\": " },
            "url": { "raw": "{{baseUrl}}/does-not-exist", "host": ["{{baseUrl}}"], "path": ["does-not-exist"] },
            "description": "Body parsing runs before routing, so invalid JSON returns `INVALID_JSON` even on an unknown route."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('INVALID_JSON', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_JSON'));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
